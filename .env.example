# Supabase Configuration
# Can be obtained from your free Supabase project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Direct URL (optional, for direct migrations)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# Google Gemini API Key
# Free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Storage bucket name in Supabase Storage (must be created as private bucket)
SUPABASE_STORAGE_BUCKET=knowdrive-files

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode configuration: set to 'true' to force demo/offline mode even if keys are unset
ENABLE_DEMO_MODE=true
